			nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
			nameLbl.Parent = ItemBtn

			local badge = Instance.new("TextLabel")
			badge.Size = UDim2.fromOffset(48, 20)
			badge.Position = UDim2.new(1, -54, 0.5, -10)
			badge.BackgroundColor3 = Color3.fromRGB(115, 80, 235)
			badge.Text = "FLING"
			badge.TextColor3 = Color3.fromRGB(255, 255, 255)
			badge.TextSize = 10
			badge.Font = Enum.Font.GothamBold
			badge.Parent = ItemBtn

			local badgeCorner = Instance.new("UICorner")
			badgeCorner.CornerRadius = UDim.new(0, 4)
			badgeCorner.Parent = badge

			ItemBtn.MouseButton1Click:Connect(function()
				local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not myHrp then return end

				if TargetPlayer == plr then
					TargetPlayer = nil
					if not TouchFlingActive then
						StopFlingEngine()
					else
						ZeroVelocityAndReturn()
					end
				else
					if not SavedCFrame then
						SavedCFrame = myHrp.CFrame
					end
					TargetPlayer = plr
					StartFlingEngine()
				end
			end)

			PlayerButtons[plr.UserId] = ItemBtn
		end
	end
end

RefreshPlayerList()
Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(function(plr)
	if TargetPlayer == plr then
		TargetPlayer = nil
		if not TouchFlingActive then
			StopFlingEngine()
		else
			ZeroVelocityAndReturn()
		end
	end
	RefreshPlayerList()
end)

