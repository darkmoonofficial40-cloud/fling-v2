			NameTxt.TextXAlignment = Enum.TextXAlignment.Left
			NameTxt.TextTruncate = Enum.TextTruncate.AtEnd
			NameTxt.Parent = ItemBtn

			local ActionBadge = Instance.new("TextLabel")
			ActionBadge.Size = UDim2.new(0, 48, 0, 20)
			ActionBadge.Position = UDim2.new(1, -54, 0.5, -10)
			ActionBadge.BackgroundColor3 = Color3.fromRGB(115, 80, 235)
			ActionBadge.Text = "FLING"
			ActionBadge.TextColor3 = Color3.fromRGB(255, 255, 255)
			ActionBadge.TextSize = 10
			ActionBadge.Font = Enum.Font.GothamBold
			ActionBadge.Parent = ItemBtn

			local BadgeCorner = Instance.new("UICorner")
			BadgeCorner.CornerRadius = UDim.new(0, 4)
			BadgeCorner.Parent = ActionBadge

			ItemBtn.MouseButton1Click:Connect(function()
				local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not myHrp then return end

				if TargetPlayer == plr then
					TargetPlayer = nil
					if not TouchFlingActive then
						StopAllFling()
					else
						ReturnToSavedPosition()
					end
				else
					if not SavedCFrame then
						SavedCFrame = myHrp.CFrame
					end
					TargetPlayer = plr
					EnsurePhysicsLoop()
				end
			end)

			PlayerButtons[plr.UserId] = ItemBtn
		end
	end
end

RefreshPlayerList()
Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(function(plr)
	if TargetPlayer == plr then
		TargetPlayer = nil
		if not TouchFlingActive then
			StopAllFling()
		else
			ReturnToSavedPosition()
		end
	end
	RefreshPlayerList()
end)

