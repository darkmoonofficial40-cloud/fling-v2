-- Character Part Cache
local function RebuildCache(char)
	table.clear(CachedParts)
	if not char then return end
	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BasePart") then
			table.insert(CachedParts, obj)
		end
	end
end

local function HookCharacter(char)
	RebuildCache(char)
	char.DescendantAdded:Connect(function(desc)
		if desc:IsA("BasePart") then
			table.insert(CachedParts, desc)
		end
	end)
end

if LocalPlayer.Character then
	HookCharacter(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(HookCharacter)

local function SetPartsCanCollide(canCollide)
	for i = 1, #CachedParts do
		local part = CachedParts[i]
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end
end

local function ZeroVelocityAndReturn()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.AssemblyLinearVelocity = Vector3.zero
		if SavedCFrame then
			hrp.CFrame = SavedCFrame
			SavedCFrame = nil
		end
	end
end

local function StopFlingEngine()
	TargetPlayer = nil
	if StepConnection then
		StepConnection:Disconnect()
		StepConnection = nil
	end
	if HeartbeatConnection then
		HeartbeatConnection:Disconnect()
		HeartbeatConnection = nil
	end

	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
	end

	ZeroVelocityAndReturn()
	SetPartsCanCollide(true)
end

local function StartFlingEngine()
	if StepConnection then StepConnection:Disconnect() end
	if HeartbeatConnection then HeartbeatConnection:Disconnect() end

	-- Keep character parts non-colliding during fling so self-impulses don't bounce you
	StepConnection = RunService.Stepped:Connect(function()
		if not TouchFlingActive and not TargetPlayer then return end
		SetPartsCanCollide(false)
	end)

	local orbitAngle = 0
	HeartbeatConnection = RunService.Heartbeat:Connect(function(dt)
		if not TouchFlingActive and not TargetPlayer then return end

		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end

		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

		if TargetPlayer then
			local tChar = TargetPlayer.Character
			local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

			-- Stop target lock cleanly if target leaves, respawns, or gets launched
			if not tHrp or not tHum or tHum.Health <= 0 or tHrp.AssemblyLinearVelocity.Magnitude > 220 then
				TargetPlayer = nil
				if not TouchFlingActive then
					StopFlingEngine()
				else
					ZeroVelocityAndReturn()
				end
				return
			end

			orbitAngle = orbitAngle + (dt * 45)
			local offset = Vector3.new(math.cos(orbitAngle) * 1.35, 0, math.sin(orbitAngle) * 1.35)
			hrp.CFrame = CFrame.new(tHrp.Position + offset)
		end

		-- Controlled rotational spin without extreme 1e6/1e5 velocity spikes that cause self-reset
		hrp.AssemblyAngularVelocity = Vector3.new(0, 2500, 0)
		if TargetPlayer then
			hrp.AssemblyLinearVelocity = Vector3.new(0, 45, 0)
		end
	end)
end

