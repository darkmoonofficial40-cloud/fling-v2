				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not hrp then return end

				if State.TargetPlayer == plr then
					State.TargetPlayer = nil
					if not State.TouchFling then
						StopFlingCompletely()
					else
						RestoreSavedCFrame()
					end
					RebuildPlayerRows()
				else
					if not State.SavedCFrame then
						State.SavedCFrame = hrp.CFrame
					end
					State.TargetPlayer = plr
					StartFlingEngine()
					RebuildPlayerRows()
				end
			end)

			tpBtn.MouseButton1Click:Connect(function()
				local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local tHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if myHrp and tHrp then
					myHrp.AssemblyLinearVelocity = Vector3.zero
					myHrp.AssemblyAngularVelocity = Vector3.zero
					myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, -3)
				end
			end)

			viewBtn.MouseButton1Click:Connect(function()
				local cam = workspace.CurrentCamera
				local tHum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
				if not cam or not tHum then return end

				if State.ViewingPlayer == plr then
					ResetCameraToSelf()
				else
					State.ViewingPlayer = plr
					cam.CameraSubject = tHum
					RebuildPlayerRows()
				end
			end)

			PlayerRowRefs[plr.UserId] = {
				row = row,
				viewBtn = viewBtn,
			}
		end
	end
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	State.SearchText = SearchBox.Text
	RebuildPlayerRows()
end)

RebuildPlayerRows()
Players.PlayerAdded:Connect(RebuildPlayerRows)
Players.PlayerRemoving:Connect(function(plr)
	if State.TargetPlayer == plr then
		State.TargetPlayer = nil
		if not State.TouchFling then
			StopFlingCompletely()
		else
			RestoreSavedCFrame()
		end
	end
	if State.ViewingPlayer == plr then
		ResetCameraToSelf()
	end
	RebuildPlayerRows()
end)

-- Character Respawn Safety
local function AttachCharacterHooks(char)
	StopFlingCompletely()
	RefreshPartCache(char)

	char.DescendantAdded:Connect(function(desc)
		if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
			table.insert(CachedNonRoot, desc)
		end
	end)

	local hum = char:WaitForChild("Humanoid", 5)
	if hum then
		if State.SpeedBoost then hum.WalkSpeed = 28 end
		if State.JumpBoost then
			hum.UseJumpPower = true
			hum.JumpPower = 72
		end
		hum.Died:Connect(function()
			StopFlingCompletely()
		end)
	end
end

if LocalPlayer.Character then
	AttachCharacterHooks(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(AttachCharacterHooks)

-- Anti-Void & Movement Guard
Connections.GuardHeartbeat = RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if hum then
		if State.SpeedBoost and hum.WalkSpeed ~= 28 then
			hum.WalkSpeed = 28
		end
		if State.JumpBoost and hum.JumpPower ~= 72 then
			hum.UseJumpPower = true
			hum.JumpPower = 72
		end
	end

	if State.AntiVoid and hrp and hrp.Position.Y < -40 then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = FindSafeLobbyCFrame()
	end
end)

