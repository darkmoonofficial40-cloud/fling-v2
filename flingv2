-- Helper to create a clean toggle switch row
local function CreateSwitchRow(yPos, labelText, initialState, onChanged)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -24, 0, 36)
	row.Position = UDim2.fromOffset(12, yPos)
	row.BackgroundColor3 = Color3.fromRGB(22, 22, 31)
	row.BorderSizePixel = 0
	row.Parent = MainFrame
	AddCorner(row, 8)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.68, 0, 1, 0)
	lbl.Position = UDim2.fromOffset(10, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelText
	lbl.TextColor3 = Color3.fromRGB(220, 220, 235)
	lbl.TextSize = 12
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local bg = Instance.new("TextButton")
	bg.Size = UDim2.fromOffset(42, 20)
	bg.Position = UDim2.new(1, -52, 0.5, -10)
	bg.BackgroundColor3 = initialState and Color3.fromRGB(120, 85, 240) or Color3.fromRGB(45, 45, 58)
	bg.Text = ""
	bg.AutoButtonColor = false
	bg.Parent = row
	AddCorner(bg, 999)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(14, 14)
	knob.Position = initialState and UDim2.new(1, -17, 0.5, -7) or UDim2.fromOffset(3, 3)
	knob.BackgroundColor3 = Color3.fromRGB(245, 245, 255)
	knob.BorderSizePixel = 0
	knob.Parent = bg
	AddCorner(knob, 999)

	local active = initialState
	local tInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local function SetVisual(state)
		active = state
		TweenService:Create(bg, tInfo, {
			BackgroundColor3 = state and Color3.fromRGB(120, 85, 240) or Color3.fromRGB(45, 45, 58)
		}):Play()
		TweenService:Create(knob, tInfo, {
			Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.fromOffset(3, 3)
		}):Play()
	end

	bg.MouseButton1Click:Connect(function()
		SetVisual(not active)
		if onChanged then
			onChanged(active)
		end
	end)

	return SetVisual
end

-- Character Cache & Safe Helpers
local function RebuildCharacterCache(char)
	table.clear(CachedParts)
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(CachedParts, d)
		end
	end
end

local function OnCharacterReady(char)
	RebuildCharacterCache(char)
	char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			table.insert(CachedParts, d)
		end
	end)
end

if LocalPlayer.Character then
	OnCharacterReady(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(OnCharacterReady)

local function SetCharacterCollide(collide)
	for i = 1, #CachedParts do
		local p = CachedParts[i]
		if p and p.Parent then
			p.CanCollide = collide
		end
	end
end

local function ResetMomentumAndReturn()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.AssemblyLinearVelocity = Vector3.zero
		if State.SavedCFrame then
			hrp.CFrame = State.SavedCFrame
			State.SavedCFrame = nil
		end
	end
end

local function FindSafeIslandCFrame()
	local spawns = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("SpawnLocation") then
			table.insert(spawns, obj.CFrame + Vector3.new(0, 4, 0))
		elseif obj:IsA("BasePart") and (obj.Name:lower():find("lobby") or obj.Name:lower():find("island") or obj.Name:lower():find("safe")) then
			if obj.Size.X > 15 and obj.Size.Z > 15 then
				table.insert(spawns, obj.CFrame + Vector3.new(0, obj.Size.Y * 0.5 + 3, 0))
			end
		end
	end
	if #spawns > 0 then
		return spawns[1]
	end
	return CFrame.new(0, 60, 0)
end

local function StopFling()
	State.TargetPlayer = nil
	if Connections.Stepped then
		Connections.Stepped:Disconnect()
		Connections.Stepped = nil
	end
	if Connections.Heartbeat then
		Connections.Heartbeat:Disconnect()
		Connections.Heartbeat = nil
	end

	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
	end

	ResetMomentumAndReturn()
	SetCharacterCollide(true)
end

local function StartFling()
	if Connections.Stepped then Connections.Stepped:Disconnect() end
	if Connections.Heartbeat then Connections.Heartbeat:Disconnect() end

	Connections.Stepped = RunService.Stepped:Connect(function()
		if not State.TouchFling and not State.TargetPlayer then return end
		SetCharacterCollide(false)
	end)

	local angle = 0
	Connections.Heartbeat = RunService.Heartbeat:Connect(function(dt)
		if not State.TouchFling and not State.TargetPlayer then return end

		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end

		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

		if State.TargetPlayer then
			local tChar = State.TargetPlayer.Character
			local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

			if not tHrp or not tHum or tHum.Health <= 0 or tHrp.AssemblyLinearVelocity.Magnitude > 220 then
				State.TargetPlayer = nil
				if not State.TouchFling then
					StopFling()
				else
					ResetMomentumAndReturn()
				end
				return
			end

			angle += dt * 45
			local offset = Vector3.new(math.cos(angle) * 1.3, 0, math.sin(angle) * 1.3)
			hrp.CFrame = CFrame.new(tHrp.Position + offset)
		end

		hrp.AssemblyAngularVelocity = Vector3.new(0, 2400, 0)
		if State.TargetPlayer then
			hrp.AssemblyLinearVelocity = Vector3.new(0, 40, 0)
		end
	end)
end

-- Anti-Void Watcher
Connections.VoidWatch = RunService.Heartbeat:Connect(function()
	if not State.AntiVoid then return end
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if hrp and hrp.Position.Y < -35 then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = FindSafeIslandCFrame()
	end
end)

