local function RebuildPlayerList()
	for _, item in pairs(PlayerItems) do
		item:Destroy()
	end
	table.clear(PlayerItems)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local btn = Instance.new("TextButton")
			btn.Name = plr.Name
			btn.Size = UDim2.new(1, 0, 0, 30)
			btn.BackgroundColor3 = Color3.fromRGB(28, 28, 39)
			btn.Text = ""
			btn.AutoButtonColor = false
			btn.Parent = PlayerScroll
			AddCorner(btn, 6)

			local nameLbl = Instance.new("TextLabel")
			nameLbl.Size = UDim2.new(0.72, 0, 1, 0)
			nameLbl.Position = UDim2.fromOffset(10, 0)
			nameLbl.BackgroundTransparency = 1
			nameLbl.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
			nameLbl.TextColor3 = Color3.fromRGB(225, 225, 240)
			nameLbl.TextSize = 11
			nameLbl.Font = Enum.Font.GothamMedium
			nameLbl.TextXAlignment = Enum.TextXAlignment.Left
			nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
			nameLbl.Parent = btn

			local badge = Instance.new("TextLabel")
			badge.Size = UDim2.fromOffset(46, 18)
			badge.Position = UDim2.new(1, -52, 0.5, -9)
			badge.BackgroundColor3 = Color3.fromRGB(120, 85, 240)
			badge.Text = "FLING"
			badge.TextColor3 = Color3.fromRGB(255, 255, 255)
			badge.TextSize = 10
			badge.Font = Enum.Font.GothamBold
			badge.Parent = btn
			AddCorner(badge, 4)

			btn.MouseButton1Click:Connect(function()
				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not hrp then return end

				if State.TargetPlayer == plr then
					State.TargetPlayer = nil
					if not State.TouchFling then
						StopFling()
					else
						ResetMomentumAndReturn()
					end
				else
					if not State.SavedCFrame then
						State.SavedCFrame = hrp.CFrame
					end
					State.TargetPlayer = plr
					StartFling()
				end
			end)

			PlayerItems[plr.UserId] = btn
		end
	end
end

RebuildPlayerList()
Players.PlayerAdded:Connect(RebuildPlayerList)
Players.PlayerRemoving:Connect(function(plr)
	if State.TargetPlayer == plr then
		State.TargetPlayer = nil
		if not State.TouchFling then
			StopFling()
		else
			ResetMomentumAndReturn()
		end
	end
	RebuildPlayerList()
end)

