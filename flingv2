-- Helper for Logo / Fallback
local function CreateLogoElement(parentObj, fallbackText, textSize, isButton)
	if LogoImageId ~= "" then
		local img = Instance.new(isButton and "ImageButton" or "ImageLabel")
		img.Size = UDim2.fromScale(1, 1)
		img.Position = UDim2.fromScale(0, 0)
		img.BackgroundTransparency = 1
		img.Image = LogoImageId
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = parentObj

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = img
		return img
	else
		local lbl = Instance.new(isButton and "TextButton" or "TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.Position = UDim2.fromScale(0, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = fallbackText
		lbl.TextColor3 = Color3.fromRGB(175, 145, 255)
		lbl.TextSize = textSize
		lbl.Font = Enum.Font.GothamBold
		if isButton then
			lbl.AutoButtonColor = false
		end
		lbl.Parent = parentObj
		return lbl
	end
end

