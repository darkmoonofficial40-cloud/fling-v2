-- UI Styling Helpers
local function AddRound(inst, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = inst
	return c
end

local function AddBorder(inst, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1.2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return s
end

local function CreateLogoView(parent, fallbackGlyph, sizePx, asButton)
	if LogoAsset ~= "" then
		local img = Instance.new(asButton and "ImageButton" or "ImageLabel")
		img.Size = UDim2.fromScale(1, 1)
		img.Position = UDim2.fromScale(0, 0)
		img.BackgroundTransparency = 1
		img.Image = LogoAsset
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = parent
		AddRound(img, 999)
		return img
	else
		local lbl = Instance.new(asButton and "TextButton" or "TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.Position = UDim2.fromScale(0, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = fallbackGlyph
		lbl.TextColor3 = Color3.fromRGB(182, 152, 255)
		lbl.TextSize = sizePx
		lbl.Font = Enum.Font.GothamBold
		if asButton then
			lbl.AutoButtonColor = false
		end
		lbl.Parent = parent
		return lbl
	end
end

