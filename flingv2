-- Helper to apply logo to either a full button or header icon
local function ApplyLogo(parentObj, fallbackText, textSize, isFullButton)
	if LogoImageId ~= "" then
		local img = Instance.new(isFullButton and "ImageButton" or "ImageLabel")
		img.Size = isFullButton and UDim2.new(1, -6, 1, -6) or UDim2.new(0, 24, 0, 24)
		img.Position = isFullButton and UDim2.new(0, 3, 0, 3) or UDim2.new(0, 0, 0.5, -12)
		img.BackgroundTransparency = 1
		img.Image = LogoImageId
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = parentObj

		local imgCorner = Instance.new("UICorner")
		imgCorner.CornerRadius = UDim.new(1, 0)
		imgCorner.Parent = img
		return img
	else
		local lbl = Instance.new(isFullButton and "TextButton" or "TextLabel")
		lbl.Size = isFullButton and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 24, 0, 24)
		lbl.Position = isFullButton and UDim2.new(0, 0, 0, 0) or UDim2.new(0, 0, 0.5, -12)
		lbl.BackgroundTransparency = 1
		lbl.Text = fallbackText
		lbl.TextColor3 = Color3.fromRGB(170, 140, 255)
		lbl.TextSize = textSize
		lbl.Font = Enum.Font.GothamBold
		if isFullButton then
			lbl.AutoButtonColor = false
		end
		lbl.Parent = parentObj
		return lbl
	end
end

