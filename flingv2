-- Cache character BaseParts to avoid expensive GetDescendants() every frame
local function RebuildPartCache(char)
	table.clear(CachedParts)
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			table.insert(CachedParts, part)
		end
	end
end

if LocalPlayer.Character then
	RebuildPartCache(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(function(char)
	RebuildPartCache(char)
	char.DescendantAdded:Connect(function(desc)
		if desc:IsA("BasePart") then
			table.insert(CachedParts, desc)
		end
	end)
end)

local function RestoreCollisions(state)
	for i = 1, #CachedParts do
		local part = CachedParts[i]
		if part and part.Parent then
			part.CanCollide = state
		end
	end
end

local function ReturnToSavedPosition()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.AssemblyLinearVelocity = Vector3.zero
		if SavedCFrame then
			hrp.CFrame = SavedCFrame
			SavedCFrame = nil
		end
	end
end

local function StopAllFling()
	TargetPlayer = nil
	if PhysicsConnection then
		PhysicsConnection:Disconnect()
		PhysicsConnection = nil
	end
	if NoclipConnection then
		NoclipConnection:Disconnect()
		NoclipConnection = nil
	end

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
	end

	ReturnToSavedPosition()
	RestoreCollisions(true)
end

local function EnsurePhysicsLoop()
	if NoclipConnection then NoclipConnection:Disconnect() end
	if PhysicsConnection then PhysicsConnection:Disconnect() end

	NoclipConnection = RunService.Stepped:Connect(function()
		RestoreCollisions(false)
	end)

	local spinAngle = 0
	PhysicsConnection = RunService.Heartbeat:Connect(function(dt)
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return end

		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

		if TargetPlayer then
			local tChar = TargetPlayer.Character
			local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

			-- Stop target lock when target dies, leaves, or gets launched
			if not tHrp or not tHum or tHum.Health <= 0 or tHrp.AssemblyLinearVelocity.Magnitude > 300 then
				TargetPlayer = nil
				if not TouchFlingActive then
					StopAllFling()
				else
					ReturnToSavedPosition()
				end
				return
			end

			spinAngle = spinAngle + (dt * 75)
			local predictedPos = tHrp.Position + (tHrp.AssemblyLinearVelocity * 0.05)
			local orbitOffset = Vector3.new(math.cos(spinAngle) * 1.1, 0, math.sin(spinAngle) * 1.1)
			hrp.CFrame = CFrame.new(predictedPos + orbitOffset)
		end

		local savedVel = hrp.AssemblyLinearVelocity
		hrp.AssemblyAngularVelocity = Vector3.new(0, 1e6, 0)
		hrp.AssemblyLinearVelocity = Vector3.new(savedVel.X * 180, 1e5, savedVel.Z * 180)

		RunService.RenderStepped:Once(function()
			if hrp and hrp.Parent then
				hrp.AssemblyLinearVelocity = TargetPlayer and Vector3.zero or savedVel
			end
		end)
	end)
end

