-- Character Cache & Safe Physics Helpers
local function RefreshPartCache(char)
	table.clear(CachedNonRoot)
	if not char then return end
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
			table.insert(CachedNonRoot, desc)
		end
	end
end

local function SetNonRootCanCollide(canCollide)
	for i = 1, #CachedNonRoot do
		local part = CachedNonRoot[i]
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end
end

local function ClearSpinnerParts()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local spinner = hrp:FindFirstChild("NDSFlingSpinner")
	if spinner then spinner:Destroy() end
	local att = hrp:FindFirstChild("NDSFlingAtt")
	if att then att:Destroy() end
end

local function EnsureSpinner(hrp)
	local att = hrp:FindFirstChild("NDSFlingAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "NDSFlingAtt"
		att.Parent = hrp
	end

	local spinner = hrp:FindFirstChild("NDSFlingSpinner")
	if not spinner then
		spinner = Instance.new("AngularVelocity")
		spinner.Name = "NDSFlingSpinner"
		spinner.Attachment0 = att
		spinner.RelativeTo = Enum.ActuatorRelativeTo.World
		spinner.MaxTorque = 1e6
		spinner.Parent = hrp
	end
	spinner.AngularVelocity = Vector3.new(0, State.FlingPower, 0)
	return spinner
end

local function ResetCameraToSelf()
	State.ViewingPlayer = nil
	local cam = workspace.CurrentCamera
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if cam and hum then
		cam.CameraSubject = hum
		cam.CameraType = Enum.CameraType.Custom
	end
	for _, entry in pairs(PlayerRowRefs) do
		if entry.viewBtn then
			entry.viewBtn.Text = "VIEW"
			entry.viewBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
		end
	end
end

local function RestoreSavedCFrame()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		if State.SavedCFrame then
			hrp.CFrame = State.SavedCFrame
			State.SavedCFrame = nil
		end
	end
end

local function DisconnectFlingLoops()
	if Connections.FlingStep then
		Connections.FlingStep:Disconnect()
		Connections.FlingStep = nil
	end
	if Connections.FlingBeat then
		Connections.FlingBeat:Disconnect()
		Connections.FlingBeat = nil
	end
end

local function StopFlingCompletely()
	State.TargetPlayer = nil
	DisconnectFlingLoops()
	ClearSpinnerParts()
	ResetCameraToSelf()

	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
	end

	SetNonRootCanCollide(true)
	RestoreSavedCFrame()
end

local function StartFlingEngine()
	DisconnectFlingLoops()

	local initHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if initHrp then
		EnsureSpinner(initHrp)
	end

	Connections.FlingStep = RunService.Stepped:Connect(function()
		if not State.TouchFling and not State.TargetPlayer then return end
		SetNonRootCanCollide(false)
	end)

	local orbitPhase = 0
	Connections.FlingBeat = RunService.Heartbeat:Connect(function(dt)
		if not State.TouchFling and not State.TargetPlayer then return end

		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end

		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

		local spinner = EnsureSpinner(hrp)
		spinner.AngularVelocity = Vector3.new(0, State.FlingPower, 0)

		if State.TargetPlayer then
			local tChar = State.TargetPlayer.Character
			local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

			-- Auto-release when target is knocked out, leaves, or gets launched
			if not tHrp or not tHum or tHum.Health <= 0 or tHrp.AssemblyLinearVelocity.Magnitude > 220 then
				State.TargetPlayer = nil
				if State.ViewingPlayer == State.TargetPlayer then
					ResetCameraToSelf()
				end
				if not State.TouchFling then
					StopFlingCompletely()
				else
					RestoreSavedCFrame()
				end
				return
			end

			orbitPhase += dt * 36
			local ring = Vector3.new(math.cos(orbitPhase) * 1.2, 0, math.sin(orbitPhase) * 1.2)
			local targetSpot = tHrp.Position + (tHrp.AssemblyLinearVelocity * 0.035) + ring
			hrp.CFrame = CFrame.new(targetSpot)
			hrp.AssemblyLinearVelocity = Vector3.new(0, 30, 0)
		end
	end)
end

-- Map / Safe Spot Helpers for Natural Disaster Survival
local function FindSafeLobbyCFrame()
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("SpawnLocation") then
			return inst.CFrame + Vector3.new(0, 4, 0)
		end
	end
	return CFrame.new(0, 65, 0)
end

local function FindHighestSafePoint()
	local bestY = -math.huge
	local bestCF = nil
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and part.Anchored and part.CanCollide then
			if part.Size.X >= 10 and part.Size.Z >= 10 and part.Position.Y > bestY and part.Position.Y < 500 then
				bestY = part.Position.Y
				bestCF = part.CFrame + Vector3.new(0, part.Size.Y * 0.5 + 3.5, 0)
			end
		end
	end
	return bestCF or FindSafeLobbyCFrame()
end

